{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xk-ingest/mutation-set-schema/v1",
  "title": "xk-ingest mutation set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "raw_chunks",
    "wiki_page_draft",
    "index_draft",
    "link_draft",
    "log_draft",
    "completeness_report"
  ],
  "properties": {
    "schema_name": {
      "type": "string",
      "const": "xk-ingest-mutation-set"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "raw_chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["chunk_id", "raw_id", "locator", "text", "order"],
        "properties": {
          "chunk_id": {"type": "string"},
          "raw_id": {"type": "string"},
          "locator": {"type": "string"},
          "text": {"type": "string"},
          "order": {"type": "integer"}
        }
      }
    },
    "wiki_page_draft": {
      "type": "object",
      "additionalProperties": true,
      "required": ["page_id", "slug", "title", "wiki_type", "summary", "body_sections", "source_chunk_ids", "status"],
      "properties": {
        "page_id": {"type": "string"},
        "slug": {"type": "string"},
        "title": {"type": "string"},
        "wiki_type": {"type": "string"},
        "summary": {"type": "string"},
        "body_sections": {"type": "array"},
        "source_chunk_ids": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "status": {"type": "string"}
      }
    },
    "index_draft": {
      "type": "object",
      "additionalProperties": true,
      "required": ["entries"],
      "properties": {
        "entries": {"type": "array"}
      }
    },
    "link_draft": {
      "type": "object",
      "additionalProperties": true,
      "required": ["entries"],
      "properties": {
        "entries": {"type": "array"}
      }
    },
    "log_draft": {
      "type": "object",
      "additionalProperties": true,
      "required": ["log_date", "action", "page_ids", "raw_id", "message"],
      "properties": {
        "log_date": {"type": "string"},
        "action": {"type": "string"},
        "page_ids": {"type": "array", "items": {"type": "string"}},
        "raw_id": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "completeness_report": {
      "type": "object",
      "additionalProperties": true,
      "required": ["summary", "covered_chunk_ids"],
      "properties": {
        "summary": {"type": "string"},
        "covered_chunk_ids": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      }
    }
  }
}
